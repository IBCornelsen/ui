{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": true
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", ".storybook/**/*.ts"]
}
