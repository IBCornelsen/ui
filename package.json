{
  "name": "@ibc/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Shared IBC UI library — design tokens + Svelte components, showcased in Storybook.",
  "svelte": "./src/lib/index.ts",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts"
    },
    "./tokens.css": "./src/lib/tokens.css",
    "./mobile-eingaben.css": "./src/lib/mobile-eingaben.css",
    "./technik": {
      "types": "./src/lib/components/TechnikIcon/technikIkonen.ts",
      "svelte": "./src/lib/components/TechnikIcon/technikIkonen.ts",
      "import": "./src/lib/components/TechnikIcon/technikIkonen.ts",
      "default": "./src/lib/components/TechnikIcon/technikIkonen.ts"
    },
    "./components/*": "./src/lib/components/*"
  },
  "files": [
    "src/lib"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "phosphor-svelte": "^3.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/svelte": "^10.5.0",
    "@storybook/svelte-vite": "^10.5.0",
    "@sveltejs/vite-plugin-svelte": "^6",
    "@tailwindcss/vite": "^4.0.0",
    "phosphor-svelte": "^3.1.0",
    "storybook": "^10.5.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7"
  }
}
