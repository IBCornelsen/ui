{
	"name": "@ibc/ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Shared IBC UI library — design tokens + Svelte components, showcased in Storybook.",
	"svelte": "./src/lib/index.ts",
	"types": "./src/lib/index.ts",
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts"
		},
		"./tokens.css": "./src/lib/tokens.css",
		"./technik": {
			"types": "./src/lib/components/TechnikIcon/technikIkonen.ts",
			"svelte": "./src/lib/components/TechnikIcon/technikIkonen.ts",
			"import": "./src/lib/components/TechnikIcon/technikIkonen.ts",
			"default": "./src/lib/components/TechnikIcon/technikIkonen.ts"
		},
		"./components/*": "./src/lib/components/*"
	},
	"files": [
		"src/lib"
	],
	"scripts": {
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"lint:legacy": "bun ../../scripts/eslint-legacy.mts",
		"format": "prettier --write ."
	},
	"peerDependencies": {
		"phosphor-svelte": "^3.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/svelte": "^10.5.0",
		"@storybook/svelte-vite": "^10.5.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"phosphor-svelte": "^3.1.0",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"storybook": "^10.5.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0",
		"vite": "^8.0.16"
	}
}
